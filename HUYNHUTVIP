local function FindEggs()
    for _, item in pairs(List:GetChildren()) do
        if item:IsA("TextButton") then
            item:Destroy()
        end
    end

    local count = 0

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(
            string.lower(obj.Name), "egg"
        ) then
            count += 1

            local Button = Instance.new("TextButton")
            Button.Size = UDim2.new(1, -10, 0, 42)
            Button.BackgroundColor3 = Color3.fromRGB(65, 30, 100)
            Button.TextColor3 = Color3.new(1, 1, 1)
            Button.TextSize = 13
            Button.Font = Enum.Font.GothamBold
            Button.Text = obj.Name .. " | Select"
            Button.Parent = List

            local ButtonCorner = Instance.new("UICorner")
            ButtonCorner.CornerRadius = UDim.new(0, 8)
            ButtonCorner.Parent = Button

            Button.MouseButton1Click:Connect(function()
                local part = obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart", true)

                if part then
                    Status.Text = "Selected: " .. obj.Name

                    -- Định vị đối tượng đã chọn
                    -- Không tự dịch chuyển hoặc chiếm trứng.
                    local camera = Workspace.CurrentCamera
                    camera.Focus = CFrame.new(part.Position)
                end
            end)
        end
    end

    List.CanvasSize = UDim2.new(0, 0, 0, count * 49)
    Status.Text = "Found " .. count .. " eggs"
end

local Refresh = Instance.new("TextButton")
Refresh.Position = UDim2.new(0, 12, 0, 335)
