-- RGB ANIMATION
local Hue = 0

RunService.RenderStepped:Connect(function(dt)
    Hue = (Hue + dt * 0.25) % 1
    local Color = Color3.fromHSV(Hue, 1, 1)
    Stroke.Color = Color
    Title.TextColor3 = Color
end)

-- BUTTON CREATOR
local function CreateButton(Text, Position)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 220, 0, 38)
    Button.Position = Position
    Button.BackgroundColor3 = Color3.fromRGB(35, 20, 55)
    Button.Text = Text
    Button.TextColor3 = Color3.new(1, 1, 1)
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamBold
    Button.Parent = Main

    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)

    return Button
end

-- ESP EGG
local ESPEnabled = false
local Highlights = {}

local ESPButton = CreateButton(
    "ESP EGG: OFF",
    UDim2.new(0, 20, 0, 60)
)

ESPButton.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    ESPButton.Text = ESPEnabled and "ESP EGG: ON" or "ESP EGG: OFF"

    if not ESPEnabled then
        for _, Highlight in pairs(Highlights) do
            Highlight:Destroy()
        end
        table.clear(Highlights)
        return
    end

    for _, Object in ipairs(EggFolder:GetDescendants()) do
        if Object.Name:lower():find("egg") then
            local Target = Object:IsA("Model") or Object:IsA("BasePart")
            if Target then
                local Highlight = Instance.new("Highlight")
                Highlight.FillColor = Color3.fromRGB(170, 0, 255)
                Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                Highlight.Adornee = Object
                Highlight.Parent = ScreenGui
                table.insert(Highlights, Highlight)
            end
        end
    end
end)

